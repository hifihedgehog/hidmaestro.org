    "1.12.0",
    "2.0.0",
    "2.0.1",
    "2.0.2"
  ],
  "steps": [
    {
      "from": "1.12.0",
      "to": "2.0.0",
      "notes": "https://github.com/hifihedgehog/HIDMaestro/releases/tag/v2.0.0",
      "method": "30 runs per build, the two builds one after the other for each path"
    },
    {
      "from": "2.0.0",
      "to": "2.0.1",
      "notes": "https://github.com/hifihedgehog/HIDMaestro/releases/tag/v2.0.1",
      "method": "30 runs per build in each of two passes, with the order of the builds flipped between passes, three passes for start, create and Dispose, and six for the per-call rows"
